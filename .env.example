# ==============================================================================
# AcademicOmniSearch - Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Renomeie ou copie este arquivo para '.env' e insira suas credenciais:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PERIÓDICOS CAPES & PROXIES / WAF BYPASS
# ------------------------------------------------------------------------------
# Chave da API Zyte (antigo Scrapinghub) para contornar proteções CloudFront/WAF na CAPES
# Obtenha em: https://www.zyte.com/
ZYTE_API_KEY=

# Proxy dedicado para a CAPES (ex: http://usuario:senha@host:porta)
CAPES_PROXY=

# Proxy dedicado para a BRAPCI (opcional)
BRAPCI_PROXY=

# Proxies gerais de rede (descomente caso utilize proxy corporativo/acadêmico)
# HTTP_PROXY=http://proxy.instituicao.br:8080
# HTTPS_PROXY=http://proxy.instituicao.br:8080

# ------------------------------------------------------------------------------
# 2. NCBI / PUBMED (E-UTILITIES)
# ------------------------------------------------------------------------------
# Chave oficial de API do NCBI (aumenta o limite de 3 para 10 requisições/segundo)
# Obtenha gratuitamente em: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# E-mail de contato para o "polite pool" do NCBI (identificação ética da aplicação)
PUBMED_EMAIL=academicomnisearch@dev.local

# ------------------------------------------------------------------------------
# 3. OPENALEX (MÉTRICAS CIENCIOMÉTRICAS, CITAÇÕES E FWCI)
# ------------------------------------------------------------------------------
# E-mail para requisições no "polite pool" da OpenAlex (respostas mais rápidas e estáveis)
# Saiba mais em: https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL=

# ------------------------------------------------------------------------------
# 4. IEEE XPLORE SEARCH API
# ------------------------------------------------------------------------------
# Chave oficial da IEEE Xplore Search API (gratuita até 200 chamadas/dia)
# Cadastro: https://developer.ieee.org/
IEEE_API_KEY=

# ------------------------------------------------------------------------------
# 5. SCOPUS & ELSEVIER (SCIENCEDIRECT)
# ------------------------------------------------------------------------------
# Chave oficial da Elsevier Scopus API
# Cadastro: https://dev.elsevier.com/
SCOPUS_API_KEY=
ELSEVIER_API_KEY=

# Token institucional Elsevier (para uso via rede conveniada/VPN acadêmica)
ELSEVIER_INST_TOKEN=

# ------------------------------------------------------------------------------
# 6. WEB OF SCIENCE (CLARIVATE)
# ------------------------------------------------------------------------------
# Chave de API da Clarivate (Web of Science Starter/Expanded API)
# Cadastro: https://developer.clarivate.com/
WOS_API_KEY=

# ------------------------------------------------------------------------------
# 7. BANCO DE DADOS LOCAL QUALIS
# ------------------------------------------------------------------------------
# Caminho para a base SQLite com estratos Qualis/CAPES
QUALIS_DB_PATH=data/qualis.db

# ------------------------------------------------------------------------------
# 8. CONFIGURAÇÕES DO SERVIDOR STREAMLIT
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

